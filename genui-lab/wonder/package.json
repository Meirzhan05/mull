{
  "name": "wonder",
  "private": true,
  "type": "module",
  "description": "Wonder: AI learning app (Next.js) combining Wondering-style lessons/practice/FSRS with ChatGPT-style DIL generative UI, powered by Claude",
  "scripts": {
    "dev": "next dev -p 8750",
    "build": "next build",
    "start": "next start -p 8750",
    "eval": "node --env-file-if-exists=.env evals/run.js",
    "test": "node --test --test-timeout=120000 --test-force-exit test/index.js",
    "sync:import-local": "node --env-file-if-exists=.env.local server/sync/import-local.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@neondatabase/auth": "^0.7.0-beta",
    "@vercel/blob": "^2.8.2",
    "katex": "^0.19.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  }
}
