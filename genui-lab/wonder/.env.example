# Copy to .env and fill in. `npm start` loads it with --env-file-if-exists=.env.
# Required: without it (or an `ant auth login` profile) lessons, the tutor and the Teacher answer 503.
ANTHROPIC_API_KEY=
# Only needed for keys that are not scoped to a workspace (e.g. sk-ant-usr-...)
ANTHROPIC_WORKSPACE_ID=
# YouTube Data API v3 key for <Video/> clips in lessons (without it, lessons leave Videos out)
YOUTUBE_API_KEY=
# Which model each kind of call uses (server/claude.js TASK_MODELS). Defaults: Opus 5.5 for
# lessons and their critic; Sonnet 5.5 for the tutor, Teacher, course plans and grading; Haiku 5.5
# for extraction. Set one to override it, e.g. WONDER_MODEL_LESSON=claude-sonnet-5-5
WONDER_MODEL_LESSON=
WONDER_MODEL_TUTOR=
WONDER_MODEL_TEACHER=
WONDER_MODEL_CRITIC=
WONDER_MODEL_COURSE=
WONDER_MODEL_GRADE=
WONDER_MODEL_EXTRACT=
# Each Claude response logs a "[wonder] usage <task> <model>: in …, out …" line; "off" silences it
WONDER_LOG_USAGE=
# The email /privacy and /terms give for questions and data requests
WONDER_CONTACT_EMAIL=

# ---- Accounts and sync across devices (optional; leave empty for the browser-only app)
# Sync turns on only when Neon Auth AND a database are set. Adding Neon from the Vercel Marketplace
# provisions both: `vercel env pull .env.local` fills DATABASE_URL and NEON_AUTH_BASE_URL.
NEON_AUTH_BASE_URL=
# 32+ random characters signing this app's session cookies: `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=
DATABASE_URL=
# Private Vercel Blob store for uploaded PDFs (without it, files are kept in Postgres)
BLOB_READ_WRITE_TOKEN=
# Try accounts without a database (data lasts until the server stops): WONDER_SYNC_DB=memory
WONDER_SYNC_DB=

# Daily caps per signed-in user on Claude calls (server/usage.js; defaults 5/30/20/2/15/40).
# "off" or a negative number removes a cap; 0 turns that kind off.
WONDER_LIMIT_LESSON=
WONDER_LIMIT_TUTOR=
WONDER_LIMIT_TEACHER=
WONDER_LIMIT_COURSE=
WONDER_LIMIT_EXTRACT=
WONDER_LIMIT_GRADE=
# Pro plan caps (server/plans.js; defaults 100/500/300/50/300/750), same rules as above.
WONDER_PRO_LIMIT_LESSON=
WONDER_PRO_LIMIT_TUTOR=
WONDER_PRO_LIMIT_TEACHER=
WONDER_PRO_LIMIT_COURSE=
WONDER_PRO_LIMIT_EXTRACT=
WONDER_PRO_LIMIT_GRADE=
# User ids given Pro without paying (comma separated).
WONDER_PRO_USERS=
# Admin user ids (comma separated): shown as Pro, with no daily limits at all.
# Your id: GET /api/account while signed in (userId).
WONDER_ADMIN_USERS=

# ---- Buying Pro through Polar (optional; needs accounts). All three or billing stays off.
# README "Buying Pro" has the setup. POLAR_SERVER: sandbox (default, test cards) or production.
# POLAR_PRODUCT_ID: the Pro product checkout sells; more Pro products may follow, comma separated.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_SERVER=sandbox

# ---- Web Push reminders (optional; needs accounts). `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:you@example.com or https://your.site
VAPID_SUBJECT=
# Vercel sends it to the cron route as a bearer token (set it in the project's env vars)
CRON_SECRET=
