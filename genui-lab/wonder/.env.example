# Copy to .env and fill in. `npm start` loads it with --env-file-if-exists=.env.
# Leave empty to run in demo mode.
ANTHROPIC_API_KEY=
# Only needed for keys that are not scoped to a workspace (e.g. sk-ant-usr-...)
ANTHROPIC_WORKSPACE_ID=

# ---- Accounts and sync across devices (optional; leave empty for the browser-only app)
# Sync turns on only when Neon Auth AND a database are set. Adding Neon from the Vercel Marketplace
# provisions both: `vercel env pull .env.local` fills DATABASE_URL and NEON_AUTH_BASE_URL.
NEON_AUTH_BASE_URL=
# 32+ random characters signing this app's session cookies: `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=
DATABASE_URL=
# Private Vercel Blob store for uploaded PDFs (without it, files are kept in Postgres)
BLOB_READ_WRITE_TOKEN=
# Try accounts without a database (data lasts until the server stops): WONDER_SYNC_DB=memory
WONDER_SYNC_DB=

# Daily caps per signed-in user on Claude calls (server/usage.js; defaults 20/100/60/10/60/150).
# "off" or a negative number removes a cap; 0 turns that kind off. Demo mode has no caps.
WONDER_LIMIT_LESSON=
WONDER_LIMIT_TUTOR=
WONDER_LIMIT_TEACHER=
WONDER_LIMIT_COURSE=
WONDER_LIMIT_EXTRACT=
WONDER_LIMIT_GRADE=

# ---- Web Push reminders (optional; needs accounts). `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:you@example.com or https://your.site
VAPID_SUBJECT=
# Vercel sends it to the cron route as a bearer token (set it in the project's env vars)
CRON_SECRET=
